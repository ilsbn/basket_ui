  <property name="styleSheet">
   <string>QWidget#basketOverview {
    background: #ffffff;
    color: #35294a;
    font-family: "Segoe UI";
    font-size: 14px;
}
QFrame#overviewFrame {
    background: #ffffff;
    border: 2px solid #7650ed;
    border-radius: 22px;
}
QLabel { background: transparent; border: none; }
QLabel[role="heading"] { color: #30243e; font-size: 24px; font-weight: 600; }
QLabel[role="summary"] { color: #46345e; font-size: 17px; font-weight: 600; }
QComboBox {
    background: #ffffff;
    color: #453458;
    border: 1px solid #b8accb;
    border-radius: 7px;
    padding: 7px 12px;
    min-height: 22px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow {
    image: url(:/basket/chevron-down.xpm);
    width: 9px;
    height: 5px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #453458;
    selection-background-color: #e9e0ff;
    selection-color: #5932ce;
    outline: none;
}
QSpinBox[overviewField="true"] {
    background: #ffffff;
    color: #453458;
    border: 1px solid #b8accb;
    border-radius: 7px;
    padding: 7px 8px;
    min-height: 22px;
    font-size: 16px;
}
QSpinBox[overviewField="true"]:focus { border-color: #7650ed; }
</string>
