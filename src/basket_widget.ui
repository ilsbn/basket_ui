  <property name="styleSheet">
   <string>QFrame#basketWidget { font-family: "Segoe UI"; font-size: 14px; }
QLabel { background: transparent; border: none; }
QLabel[role="index"] { color: #888096; font-size: 12px; }
QLabel[role="sequence"] { color: #6a607a; font-size: 12px; }
QFrame[basketCard="true"] {
    border: 2px solid #7650ed;
    border-radius: 15px;
}
QFrame[basketState="empty"] { background: #f0f0f5; }
QFrame[basketState="in progress"] { background: #b8edbe; }
QFrame[basketState="pending"] { background: #fff0a6; }
QFrame[basketState="sold"] { background: #ffd0d0; }
QSpinBox {
    background: rgba(255, 255, 255, 195);
    color: #453458;
    border: 1px solid rgba(118, 80, 237, 65);
    border-radius: 5px;
    padding: 3px 4px;
    font-size: 12px;
}
QSpinBox:focus { border: 1px solid #7650ed; }
QComboBox[basketStatus="true"] {
    background: transparent;
    color: #6841dc;
    border: none;
    border-radius: 6px;
    padding: 7px 6px;
    font-size: 16px;
    font-weight: 500;
}
QComboBox[basketStatus="true"]:hover { background: rgba(255, 255, 255, 90); }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow {
    image: url(:/basket/chevron-down.xpm);
    width: 9px;
    height: 5px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #453458;
    selection-background-color: #e9e0ff;
    selection-color: #5932ce;
    outline: none;
}</string>
  </property>
